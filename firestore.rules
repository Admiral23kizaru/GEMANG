rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    match /testimonials/{testimonialId} {
      // A visitor can only read the testimonials already approved by the owner.
      allow read: if resource.data.status == 'approved';

      // Visitors can submit one tightly validated, pending testimonial. They cannot
      // self-publish, modify, or delete it.
      allow create: if request.resource.data.keys().hasOnly(['name', 'company', 'project', 'message', 'status', 'consent', 'createdAt'])
        && isText(request.resource.data.name, 2, 60)
        && isText(request.resource.data.company, 2, 80)
        && isText(request.resource.data.project, 2, 100)
        && isText(request.resource.data.message, 30, 800)
        && request.resource.data.status == 'pending'
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
