rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Private queue: a visitor can submit feedback, but no browser can read it.
    match /testimonialSubmissions/{submissionId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'displayName', 'organization', 'message', 'consent', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'organization', 'message', 'consent', 'createdAt'])
        && text(request.resource.data.email, 5, 254)
        && text(request.resource.data.displayName, 0, 60)
        && text(request.resource.data.organization, 0, 80)
        && text(request.resource.data.message, 15, 800)
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Public wall: only the owner adds checked, sanitized feedback through Firebase Console.
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
